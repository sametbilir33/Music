[Desktop Entry]
Name=Music
GenericName=Music Player
GenericName[tr]=Müzik Çalar
Comment=Play your local music files
Comment[tr]=Yerel müzik dosyalarınızı çalın
Exec=Music %U
Icon=io.github.sametbilir33.Music
Terminal=false
Type=Application
Categories=AudioVideo;Audio;Player;
Keywords=Music;Audio;Player;
Keywords[tr]=Müzik;Ses;Çalar;
StartupNotify=true
MimeType=audio/mpeg;audio/flac;audio/ogg;audio/opus;audio/wav;audio/x-wav;audio/mp4;audio/aac;audio/x-aiff;audio/x-ape;audio/x-ms-wma;